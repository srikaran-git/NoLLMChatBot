# Required: KodeKey for the OpenAI-compatible endpoint.
API_KEY=

# Required only for the web_search tool. GOOGLE_CSE_ID is the Programmable
# Search Engine ID (the `cx` value), not your Google Cloud project ID.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional endpoint/model overrides.
# BASE_URL=https://api.ai.kodekloud.com/v1
# MODEL=typesafe/jev-1.13.0
